---
import Layout from '../layouts/Layout.astro';
import { getNews } from '../data/news';
import {
  SITE_STATS,
  PILLARS,
  SEO_EVIDENCES,
  PRODUCTS_AND_BOOKS,
  ALL_ARTICLES,
  type Article,
} from '../data/portfolio';

const articleMap = new Map<string, Article>(
  ALL_ARTICLES.map((article) => [article.itemId, article])
);

const categoryLabels: Record<Article['category'], string> = {
  'data-pipeline': 'データ基盤',
  'gas-automation': '業務自動化',
  'ai-mcp-llm': 'AI・LLM',
  architecture: '設計思想',
};

const sortedByPv = [...ALL_ARTICLES].sort((a, b) => b.pv - a.pv);
const topArticles = sortedByPv.slice(0, 5);

const latestNews = await getNews(3);

const availableProducts = PRODUCTS_AND_BOOKS.filter((p) => p.status === 'available');
const upcomingProducts = PRODUCTS_AND_BOOKS.filter((p) => p.status !== 'available');

// 各領域で読者に見せる代表記事は PV 上位 3 本に絞る
const pillarReps = (ids: string[]) =>
  ids
    .map((id) => articleMap.get(id))
    .filter((a): a is Article => Boolean(a))
    .sort((a, b) => b.pv - a.pv)
    .slice(0, 3);

// Google フォームのURL
const GOOGLE_FORM_URL =
  'https://docs.google.com/forms/d/e/1FAIpQLScNXZCqWAvDhvRGUUxNFqIOgAePvuUZ9DCsIjOkxFcn6ia6IA/viewform';
---

<Layout>
  <header class="site-header">
    <div class="container header-inner">
      <a href="#" class="brand" aria-label="akkyey ホーム">
        <img class="brand-avatar" src="/akkyey-avatar-96.webp" alt="" width="36" height="36" />
        <span class="brand-name">akkyey</span>
        <span class="brand-desc">止まらない仕組みづくり</span>
      </a>

      <nav class="main-nav" aria-label="主要ナビゲーション">
        <a href="#services">取り組み</a>
        <a href="#about">私について</a>
        <a href="#evidence">実績</a>
        <a href="#articles">記事</a>
        <a href="/notes">技術ノート</a>
        <a href="#contact" class="nav-cta">お問い合わせ</a>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <!-- HERO -->
    <section class="hero">
      <div class="container">
        <h1 class="hero-title">
          止まらない仕組みを<br />
          つくる
        </h1>

        <p class="hero-lead">
          API制限で止まる夜間バッチ。終わらない手作業の集計。思いどおりに動かないAI。プロジェクトマネージャーとして現場を回してきた経験から、<strong>「止まる前提」で設計し、壊れても自分で立ち直る仕組み</strong>を形にしてきました。
        </p>

        <div class="hero-actions">
          <a href="#contact" class="btn btn-primary">お問い合わせ・技術相談</a>
          <a href="#services" class="btn btn-text">取り組みを見る →</a>
          <span class="hero-note">※ 技術相談・情報交換はお気軽にどうぞ</span>
        </div>

        <dl class="hero-proof">
          <div>
            <dt>キャッシュによるAIトークン削減</dt>
            <dd><span class="num">−90</span><span class="unit">%</span></dd>
          </div>
          <div>
            <dt>4,400銘柄の全データ処理</dt>
            <dd><span class="num">9</span><span class="unit">分台</span></dd>
          </div>
          <div>
            <dt>Google検索1位を獲得したテーマ</dt>
            <dd><span class="num">{SITE_STATS.seoTopCount}</span><span class="unit">件</span></dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- NEWS -->
    <section id="news" class="news-strip" aria-label="お知らせ">
      <div class="container news-strip-inner">
        <h2 class="news-strip-title">お知らせ</h2>
        <ol class="news-strip-list">
          {
            latestNews.map((n) => (
              <li>
                <time datetime={n.date}>{n.date.replaceAll('-', '.')}</time>
                <span class="news-strip-kind">{n.kind}</span>
                {n.link ? (
                  <a
                    href={n.link}
                    target={n.external ? '_blank' : undefined}
                    rel={n.external ? 'noopener noreferrer' : undefined}
                  >
                    {n.title}
                  </a>
                ) : (
                  <span>{n.title}</span>
                )}
              </li>
            ))
          }
        </ol>
        <a href="/news" class="news-strip-more">すべて見る →</a>
      </div>
    </section>

    <!-- SERVICES / PILLARS -->
    <section id="services" class="section">
      <div class="container">
        <header class="section-header">
          <p class="section-kicker">取り組んでいること</p>
          <h2 class="section-title">現場の「困った」に向き合ってきた3つの領域</h2>
        </header>

        <ol class="pillars">
          {
            PILLARS.map((pillar) => (
              <li class="pillar" id={`pillar-${pillar.id}`}>
                <div class="pillar-head">
                  <span class="pillar-no">{pillar.number}</span>
                  <div>
                    <h3 class="pillar-title">{pillar.title}</h3>
                    <p class="pillar-sub">{pillar.subtitle}</p>
                  </div>
                </div>

                <div class="pillar-body">
                  <div class="pillar-problem">
                    <h4>よくある課題</h4>
                    <p>{pillar.clientProblem}</p>
                  </div>
                  <div class="pillar-solution">
                    <h4>取り組んだアプローチ</h4>
                    <p>{pillar.businessValue}</p>
                  </div>

                  <ul class="pillar-metrics" aria-label="実績値">
                    {pillar.metrics.map((m) => (
                      <li>
                        <span class="metric-val">{m.value}</span>
                        <span class="metric-lbl">{m.label}</span>
                      </li>
                    ))}
                  </ul>

                  <p class="pillar-stack">
                    <span>使う技術</span>
                    {pillar.techStack.join(' / ')}
                  </p>

                  <div class="pillar-reads">
                    <h4>関連する記事</h4>
                    <ul>
                      {pillarReps(pillar.representativeIds).map((a) => (
                        <li>
                          <a href={a.url} target="_blank" rel="noopener noreferrer">
                            {a.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ABOUT -->
    <section id="about" class="section section-tint">
      <div class="container about">
        <figure class="portrait">
          <img
            src="/akkyey-portrait-480.webp"
            srcset="/akkyey-portrait-480.webp 480w, /akkyey-portrait-960.webp 960w"
            sizes="(max-width: 960px) 260px, 340px"
            width="480"
            height="720"
            loading="lazy"
            alt="akkyeyの自画像。白髪を後ろで束ね、VRゴーグルをかけてノートPCに向かう姿。後ろにメガネのラマ、横にペンギン。"
          />
          <figcaption>akkyey（自画像）</figcaption>
        </figure>

        <div class="about-main">
        <header class="section-header">
          <p class="section-kicker">私について</p>
          <h2 class="section-title">プロマネの視点で技術を選ぶ</h2>
        </header>

        <div class="about-body">
          <div class="about-text">
            <p>
              会社では長くプロジェクトマネージャーとして、要件・予算・納期の折り合いをつけながら現場を回してきました。そこで身についたのは、報告や見積もりを鵜呑みにせず「それは本当に動くのか」「止まったとき誰が困るのか」を最初に確かめる習慣です。
            </p>
            <p>
              いまはAIエージェントも“チームの一員”として扱い、同じ目でマネジメントしています。出てきた成果は必ず検証し、暴走やコストの膨張は仕組みの側で止める。そうした試行錯誤から得られた知見を集め、再現可能な形で技術記事やノートに見える化して発信しています。
            </p>
          </div>

          <ol class="principles">
            <li>
              <strong>止まる前提で設計する</strong>
              <span>外部APIの制限や欠損は「起きるもの」として扱い、自動で復旧する道筋を最初から組み込みます。</span>
            </li>
            <li>
              <strong>数字で確かめる</strong>
              <span>速くなった・安くなったは、処理時間やコストの実測データで検証します。</span>
            </li>
            <li>
              <strong>知見を集めて見える化する</strong>
              <span>現場の試行錯誤や泥臭いノウハウを抱え込まず、誰もが再現・活用できるドキュメントや記事として残します。</span>
            </li>
          </ol>
        </div>
        </div>
      </div>
    </section>

    <!-- EVIDENCE -->
    <section id="evidence" class="section">
      <div class="container">
        <header class="section-header">
          <p class="section-kicker">実績</p>
          <h2 class="section-title">Google検索上位を獲得した技術記事</h2>
          <p class="section-desc">
            実際に現場で起きた問題を解いた記事が、同じ問題に困っている人の検索に応えています。（{SITE_STATS.asOfDate} 時点で確認）
          </p>
        </header>

        <div class="evidence-wrap" role="region" aria-label="検索上位キーワード一覧" tabindex="0">
          <table class="evidence">
            <thead>
              <tr>
                <th scope="col">検索キーワード</th>
                <th scope="col">結果</th>
                <th scope="col">評価されたポイント</th>
              </tr>
            </thead>
            <tbody>
              {
                SEO_EVIDENCES.map((item) => (
                  <tr>
                    <td class="ev-query">
                      {item.queries.map((q) => <span>{q}</span>)}
                    </td>
                    <td class="ev-pos">{item.position}</td>
                    <td class="ev-note">{item.highlight}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- PRODUCTS -->
    <section id="products" class="section section-tint">
      <div class="container">
        <header class="section-header">
          <p class="section-kicker">ツール・書籍</p>
          <h2 class="section-title">実践ノウハウを形にしたツールと書籍</h2>
        </header>

        <div class="products">
          {
            availableProducts.map((prod) => (
              <article class="product-feature">
                <p class="product-state">{prod.priceOrLicense}</p>
                <h3>{prod.title}</h3>
                <p>{prod.description}</p>
                <ul>
                  {prod.features.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
                <a
                  href={prod.linkUrl}
                  target={prod.linkUrl.startsWith('http') ? '_blank' : undefined}
                  rel={prod.linkUrl.startsWith('http') ? 'noopener noreferrer' : undefined}
                  class="btn btn-secondary"
                >
                  {prod.linkLabel} {prod.linkUrl.startsWith('http') ? '↗' : '→'}
                </a>
              </article>
            ))
          }

          {upcomingProducts.length > 0 && (
            <div class="product-upcoming">
              <h3>準備中の書籍</h3>
              <ul>
                {upcomingProducts.map((prod) => (
                  <li>
                    <strong>{prod.title}</strong>
                    <span>{prod.badge}</span>
                  </li>
                ))}
              </ul>
              <a href="#contact" class="btn-text">公開時にお知らせを受け取る →</a>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- ARTICLES -->
    <section id="articles" class="section">
      <div class="container">
        <header class="section-header">
          <p class="section-kicker">記事</p>
          <h2 class="section-title">よく読まれている記事</h2>
          <p class="section-desc">
            Qiitaで{SITE_STATS.totalArticles}本の技術記事を公開しています（累計 {SITE_STATS.totalPv.toLocaleString()} PV）。
          </p>
        </header>

        <ol class="article-list">
          {
            topArticles.map((a) => (
              <li>
                <span class="art-cat">{categoryLabels[a.category]}</span>
                <a href={a.url} target="_blank" rel="noopener noreferrer" class="art-title">
                  {a.title}
                </a>
                <span class="art-pv">{a.pv.toLocaleString()} PV</span>
              </li>
            ))
          }
        </ol>

        <details class="all-articles">
          <summary>全{SITE_STATS.totalArticles}本を見る</summary>
          <ol class="article-list article-list-compact">
            {
              sortedByPv.slice(topArticles.length).map((a) => (
                <li>
                  <span class="art-cat">{categoryLabels[a.category]}</span>
                  <a href={a.url} target="_blank" rel="noopener noreferrer" class="art-title">
                    {a.title}
                  </a>
                  <span class="art-pv">{a.pv.toLocaleString()} PV</span>
                </li>
              ))
            }
          </ol>
        </details>

        <div class="articles-notes-banner">
          <p>
            💡 QiitaにまとめるほどでもないマニアックなCLIワンライナーや泥臭い検証ログは、
            <a href="/notes/">技術ノート（Notes） &rarr;</a> に随時ストックしています。
          </p>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="section section-tint">
      <div class="container">
        <header class="section-header">
          <p class="section-kicker">コンタクト</p>
          <h2 class="section-title">お問い合わせ・ご連絡</h2>
          <p class="section-desc">
            技術記事やコードへのご感想・ご質問、アーキテクチャの壁打ちや情報交換など、お気軽にメッセージをお寄せください。
          </p>
        </header>

        <div class="contact-container">
          <div class="contact-info">
            <h3>受付内容</h3>
            <p>
              下記のようなトピックのご連絡を受け付けています。お気軽にお送りください。
            </p>

            <ul class="contact-topics">
              <li>
                <strong>技術的なご質問・フィードバック</strong>
                <span>Qiitaや技術ノートで公開しているコード・設計についてのご質問や感想</span>
              </li>
              <li>
                <strong>技術壁打ち・情報交換</strong>
                <span>データ基盤や業務自動化（GAS / Python / Cloudflare）に関する意見交換・壁打ち</span>
              </li>
              <li>
                <strong>執筆・情報発信のご連絡</strong>
                <span>技術記事の執筆や共同検証、知見の共有に関するご連絡</span>
              </li>
            </ul>

            <p class="contact-alt">
              Qiita（<a href="https://qiita.com/akkyey" target="_blank" rel="noopener noreferrer">@akkyey</a>）経由でのご連絡も可能です。
            </p>
          </div>
          <div class="contact-form-wrapper google-form-card">
            <div class="gform-badge-row">
              <span class="gform-badge">Google フォーム受付</span>
              <span class="gform-privacy">Googleアカウント不要</span>
            </div>

            <h4 class="gform-title">メッセージフォーム</h4>
            <p class="gform-lead">
              下記ボタンから Google フォームが開きます。お名前（ニックネーム可）とご連絡先、メッセージをご記入のうえ送信してください。
            </p>

            <div class="gform-cta">
              <a
                href={GOOGLE_FORM_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary btn-large gform-btn"
              >
                Google フォームを開く ↗
              </a>
              <span class="gform-note">※ 新しいタブでGoogleフォームが開きます</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <p class="footer-brand"><strong>akkyey</strong> — 止まらないデータ基盤・業務自動化・AI活用</p>
      <nav class="footer-links" aria-label="フッターナビゲーション">
        <a href="#services">取り組み</a>
        <a href="#about">私について</a>
        <a href="#evidence">実績</a>
        <a href="#articles">記事</a>
        <a href="/notes">技術ノート</a>
        <a href="/news">お知らせ</a>
        <a href="#contact">お問い合わせ</a>
        <a href="https://qiita.com/akkyey" target="_blank" rel="noopener noreferrer">Qiita ↗</a>
      </nav>
      <p class="footer-copy">&copy; {new Date().getFullYear()} akkyey</p>
    </div>
  </footer>
</Layout>


<style>
  /* ---------- Header ---------- */
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-block-end: 1px solid var(--rule);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-block-size: 4rem;
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    color: var(--ink);
  }

  .brand:hover {
    color: var(--ink);
  }

  .brand-avatar {
    inline-size: 36px;
    block-size: 36px;
    border-radius: 50%;
    align-self: center;
    border: 1px solid var(--rule);
  }

  .brand-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: 0.02em;
  }

  .brand-desc {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    font-size: 0.9375rem;
  }

  .main-nav a {
    color: var(--ink-2);
  }

  .main-nav a:hover {
    color: var(--accent);
  }

  .main-nav .nav-cta {
    color: var(--on-accent);
    background: var(--accent);
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    font-weight: 600;
  }

  .main-nav .nav-cta:hover {
    color: var(--on-accent);
    background: var(--accent-strong);
  }

  /* ---------- Buttons ---------- */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.875rem 1.75rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 1rem;
    border: 1.5px solid transparent;
    cursor: pointer;
    font-family: inherit;
    line-height: 1.3;
    text-align: center;
  }

  .btn-primary {
    background: var(--accent);
    color: var(--on-accent);
  }

  .btn-primary:hover {
    background: var(--accent-strong);
    color: var(--on-accent);
  }

  .btn-primary:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .btn-secondary {
    background: transparent;
    color: var(--accent);
    border-color: var(--accent);
  }

  .btn-secondary:hover {
    background: var(--accent-soft);
  }

  .btn-text {
    font-weight: 600;
    color: var(--accent);
    padding-inline: 0;
  }

  /* ---------- Hero ---------- */
  .hero {
    padding-block: clamp(4rem, 10vw, 7.5rem) clamp(3rem, 7vw, 5rem);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 2rem;
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .status-dot {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--ok) 20%, transparent);
  }

  .hero-title {
    word-break: auto-phrase;
    text-wrap: balance;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(2.5rem, 6.5vw, 4.75rem);
    line-height: 1.2;
    letter-spacing: 0.01em;
    margin: 0 0 1.75rem;
    color: var(--ink);
  }

  .hero-lead {
    max-inline-size: 40em;
    font-size: clamp(1.0625rem, 1.6vw, 1.1875rem);
    line-height: 1.95;
    color: var(--ink-2);
    margin: 0 0 2.5rem;
  }

  .hero-lead strong {
    color: var(--ink);
    background: linear-gradient(transparent 62%, var(--marker) 62%);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
  }

  .hero-note {
    font-size: 0.8125rem;
    color: var(--muted);
    font-weight: 500;
  }

  .hero-proof {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: clamp(3.5rem, 7vw, 5rem) 0 0;
    border-block-start: 1px solid var(--rule);
  }

  .hero-proof > div {
    padding: 1.5rem 1.5rem 0 0;
  }

  .hero-proof > div + div {
    padding-inline-start: 1.5rem;
    border-inline-start: 1px solid var(--rule);
  }

  .hero-proof dt {
    font-size: 0.875rem;
    color: var(--muted);
    margin-block-end: 0.25rem;
  }

  .hero-proof dd {
    margin: 0;
    color: var(--ink);
  }

  .hero-proof .num {
    font-family: var(--font-num);
    font-size: clamp(2.25rem, 4vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .hero-proof .unit {
    font-size: 1rem;
    margin-inline-start: 0.2rem;
    color: var(--ink-2);
  }

  /* ---------- Sections ---------- */
  .section {
    padding-block: clamp(4rem, 9vw, 6.5rem);
  }

  .section-tint {
    background: var(--surface-tint);
    border-block: 1px solid var(--rule);
  }

  .section-header {
    max-inline-size: 52rem;
