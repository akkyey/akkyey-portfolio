---
import Layout from '../layouts/Layout.astro';
import { getNews } from '../data/news';

const news = await getNews();
const fmt = (ymd: string) => ymd.replaceAll('-', '.');
---

<Layout
  title="お知らせ | akkyey"
  description="akkyey の Qiita 新着記事、技術ノートの追加、サイトの更新などのお知らせ。"
>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand" aria-label="akkyey ホーム">
        <img
          class="brand-avatar"
          src="/akkyey-avatar-96.webp"
          alt=""
          width="36"
          height="36"
        />
        <span class="brand-name">akkyey</span>
        <span class="brand-desc">止まらない仕組みづくり</span>
      </a>

      <nav class="main-nav" aria-label="主要ナビゲーション">
        <a href="/">トップ</a>
        <a href="/#services">取り組み</a>
        <a href="/#articles">Qiita記事</a>
        <a href="/notes">技術ノート</a>
        <a href="/news" class="active">お知らせ</a>
        <a href="/#contact" class="nav-cta">お問い合わせ</a>
      </nav>
    </div>
  </header>

  <main id="main-content" class="notes-page">
    <div class="container">
      <header class="notes-header">
        <div class="breadcrumbs">
          <a href="/">ホーム</a>
          <span aria-hidden="true">/</span>
          <span>お知らせ</span>
        </div>
        <h1 class="notes-title">お知らせ</h1>
        <p class="notes-lead">
          Qiita の新着記事、技術ノートの追加、サイトの更新などをお知らせします。
        </p>
      </header>

      <section class="news-section" aria-label="お知らせ一覧">
        <ol class="news-list">
          {
            news.map((n) => (
              <li class="news-item">
                <time datetime={n.date}>{fmt(n.date)}</time>
                <span class={`news-kind kind-${n.kind === 'お知らせ' ? 'info' : n.kind === 'Qiita' ? 'qiita' : 'note'}`}>
                  {n.kind}
                </span>
                {n.link ? (
                  <a
                    class="news-title"
                    href={n.link}
                    target={n.external ? '_blank' : undefined}
                    rel={n.external ? 'noopener noreferrer' : undefined}
                  >
                    {n.title}
                    {n.external && ' ↗'}
                  </a>
                ) : (
                  <span class="news-title">{n.title}</span>
                )}
              </li>
            ))
          }
        </ol>
      </section>
    </div>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <p class="footer-brand">
        <strong>akkyey</strong> — 止まらない仕組みづくり
      </p>
      <nav class="footer-nav" aria-label="フッターナビゲーション">
        <a href="/">トップ</a>
        <a href="/#services">取り組み</a>
        <a href="/#articles">記事</a>
        <a href="/notes">技術ノート</a>
        <a href="/news">お知らせ</a>
        <a href="/#contact">お問い合わせ</a>
        <a href="https://qiita.com/akkyey" target="_blank" rel="noopener noreferrer">Qiita &nearr;</a>
      </nav>
      <p class="footer-copy">&copy; {new Date().getFullYear()} akkyey</p>
    </div>
  </footer>
</Layout>

<style>
  /* Header */
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 100;
    background: rgba(247, 245, 240, 0.92);
    backdrop-filter: blur(8px);
    border-block-end: 1px solid var(--rule);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    block-size: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--ink);
  }

  .brand-avatar {
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--rule);
    background: var(--surface);
  }

  .brand-name {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1.0625rem;
  }

  .brand-desc {
    font-size: 0.8125rem;
    color: var(--muted);
    padding-inline-start: 0.5rem;
    border-inline-start: 1px solid var(--rule);
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .main-nav a {
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .main-nav a:hover,
  .main-nav a.active {
    color: var(--accent);
  }

  .main-nav .nav-cta {
    background: var(--accent);
    color: var(--on-accent);
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
  }

  /* Notes Page */
  .notes-page {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
    margin-block-end: 1.5rem;
  }

  .breadcrumbs a {
    color: var(--muted);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--accent);
  }

  .notes-header {
    margin-block-end: clamp(2rem, 4vw, 3.5rem);
    border-block-end: 1px solid var(--rule);
    padding-block-end: 2rem;
  }

  .notes-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
  }

  .notes-lead {
    font-size: 1.0625rem;
    color: var(--ink-2);
    line-height: 1.8;
    max-inline-size: 44em;
    margin: 0 0 1.25rem;
  }

  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: 1rem;
  }

  .tags-label {
    font-size: 0.8125rem;
    color: var(--muted);
    font-weight: 600;
  }

  .tag-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.2rem 0.65rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    color: var(--ink-2);
  }

  /* Notes List */
  .notes-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .note-card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 3vw, 2rem);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .note-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
  }

  .note-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-block-end: 0.75rem;
  }

  .note-meta time {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .note-tags {
    display: flex;
    gap: 0.4rem;
  }

  .note-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  .note-card-title {
    font-size: 1.25rem;
    line-height: 1.5;
    margin: 0 0 0.6rem;
  }

  .note-card-title a {
    color: var(--ink);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .note-card-title a:hover {
    color: var(--accent);
  }

  .note-desc {
    margin: 0 0 1rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
    line-height: 1.7;
  }

  .note-more {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .note-link {
    color: var(--accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .note-link:hover {
    text-decoration: underline;
  }

  /* CTA Box */
  .notes-cta-box {
    margin-block-start: clamp(3rem, 6vw, 4.5rem);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: clamp(2rem, 4vw, 3rem);
    text-align: center;
  }

  .cta-inner h3 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
  }

  .cta-inner p {
    color: var(--ink-2);
    font-size: 0.9375rem;
    margin: 0 0 1.5rem;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  /* Footer */
  .site-footer {
    padding-block: 3rem;
    font-size: 0.875rem;
    color: var(--muted);
    border-block-start: 1px solid var(--rule);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .footer-nav a {
    color: var(--muted);
    text-decoration: none;
  }

  .footer-nav a:hover {
    color: var(--ink);
  }

  .footer-copy {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  @media (max-width: 640px) {
    .main-nav a:not(.nav-cta) {
      display: none;
    }
    .brand-desc {
      display: none;
    }
    .main-nav {
      gap: 0.85rem;
    }
  }

  .news-section {
    margin-block: 2rem 4rem;
  }

  .news-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .news-item {
    display: grid;
    grid-template-columns: 6.5rem 6.5rem minmax(0, 1fr);
    gap: 0.25rem 1rem;
    align-items: baseline;
    padding-block: 1rem;
    border-block-end: 1px solid var(--rule);
  }

  .news-item time {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .news-kind {
    font-size: 0.75rem;
    font-weight: 700;
    justify-self: start;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--surface-tint);
    color: var(--ink-2);
  }

  .kind-info {
    background: var(--accent);
    color: var(--on-accent);
  }

  .kind-qiita {
    background: #e8f5dc;
    color: #2f6b12;
  }

  .news-title {
    color: var(--ink);
    font-weight: 600;
  }

  a.news-title:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 640px) {
    .news-item {
      grid-template-columns: auto 1fr;
    }

    .news-title {
      grid-column: 1 / -1;
    }
  }
</style>
