---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);

const formatDate = (d: Date) => {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}.${m}.${day}`;
};
---

<Layout
  title={`${note.data.title} | akkyey 技術ノート`}
  description={note.data.description}
>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand" aria-label="akkyey ホーム">
        <img
          class="brand-avatar"
          src="/akkyey-avatar-96.webp"
          alt=""
          width="36"
          height="36"
        />
        <span class="brand-name">akkyey</span>
        <span class="brand-desc">止まらない仕組みづくり</span>
      </a>

      <nav class="main-nav" aria-label="主要ナビゲーション">
        <a href="/">トップ</a>
        <a href="/#services">できること</a>
        <a href="/#articles">Qiita記事</a>
        <a href="/notes" class="active">技術ノート</a>
        <a href="/#contact" class="nav-cta">相談する</a>
      </nav>
    </div>
  </header>

  <main id="main-content" class="note-detail-page">
    <div class="container article-container">
      <div class="breadcrumbs">
        <a href="/">ホーム</a>
        <span aria-hidden="true">/</span>
        <a href="/notes/">技術ノート</a>
        <span aria-hidden="true">/</span>
        <span>詳細</span>
      </div>

      <article class="note-article">
        <header class="article-header">
          <div class="article-meta">
            <time datetime={note.data.pubDate.toISOString()}>
              公開日: {formatDate(note.data.pubDate)}
            </time>
            {
              note.data.updatedDate && (
                <time datetime={note.data.updatedDate.toISOString()}>
                  (更新: {formatDate(note.data.updatedDate)})
                </time>
              )
            }
            <div class="article-tags">
              {note.data.tags.map((t) => (
                <span class="article-tag">#{t}</span>
              ))}
            </div>
          </div>

          <h1 class="article-title">{note.data.title}</h1>

          {
            note.data.description && (
              <p class="article-lead">{note.data.description}</p>
            )
          }
        </header>

        <div class="article-body">
          <Content />
        </div>

        <footer class="article-footer">
          <div class="author-card">
            <img
              src="/akkyey-avatar-96.webp"
              alt="akkyey"
              class="author-avatar"
              width="56"
              height="56"
            />
            <div class="author-info">
              <strong class="author-name">akkyey（あっきい）</strong>
              <p class="author-bio">
                プロジェクトマネージャー視点で現場を回すデータエンジニア。「止まる前提」で設計し、API制限やエラーでも自分で立ち直る仕組みを作ります。
              </p>
              <div class="author-actions">
                <a href="/#contact" class="btn btn-primary btn-small">
                  お問い合わせ・技術相談
                </a>
                <a href="/notes/" class="btn btn-text btn-small">
                  &larr; 技術ノート一覧へ戻る
                </a>
              </div>
            </div>
          </div>
        </footer>
      </article>
    </div>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <p class="footer-brand">
        <strong>akkyey</strong> — 止まらない仕組みづくり
      </p>
      <nav class="footer-nav" aria-label="フッターナビゲーション">
        <a href="/">トップ</a>
        <a href="/#services">できること</a>
        <a href="/#articles">記事</a>
        <a href="/notes">技術ノート</a>
        <a href="/#contact">お問い合わせ</a>
        <a href="https://qiita.com/akkyey" target="_blank" rel="noopener noreferrer">Qiita &nearr;</a>
      </nav>
      <p class="footer-copy">&copy; {new Date().getFullYear()} akkyey</p>
    </div>
  </footer>
</Layout>

<style>
  /* Header */
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 100;
    background: rgba(247, 245, 240, 0.92);
    backdrop-filter: blur(8px);
    border-block-end: 1px solid var(--rule);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    block-size: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--ink);
  }

  .brand-avatar {
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--rule);
    background: var(--surface);
  }

  .brand-name {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1.0625rem;
  }

  .brand-desc {
    font-size: 0.8125rem;
    color: var(--muted);
    padding-inline-start: 0.5rem;
    border-inline-start: 1px solid var(--rule);
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .main-nav a {
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .main-nav a:hover,
  .main-nav a.active {
    color: var(--accent);
  }

  .main-nav .nav-cta {
    background: var(--accent);
    color: var(--on-accent);
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
  }

  /* Note Detail */
  .note-detail-page {
    padding-block: clamp(2rem, 4vw, 4rem);
  }

  .article-container {
    max-inline-size: 48rem;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
    margin-block-end: 2rem;
  }

  .breadcrumbs a {
    color: var(--muted);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--accent);
  }

  .note-article {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: clamp(1.75rem, 5vw, 3.5rem);
  }

  .article-header {
    border-block-end: 1px solid var(--rule);
    padding-block-end: 2rem;
    margin-block-end: 2.5rem;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
    margin-block-end: 1rem;
  }

  .article-tags {
    display: flex;
    gap: 0.4rem;
  }

  .article-tag {
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
  }

  .article-title {
    font-size: clamp(1.5rem, 3.2vw, 2.125rem);
    line-height: 1.45;
    margin: 0 0 1rem;
    letter-spacing: -0.01em;
  }

  .article-lead {
    font-size: 1.0625rem;
    color: var(--ink-2);
    line-height: 1.8;
    margin: 0;
    padding: 1rem 1.25rem;
    background: var(--bg);
    border-radius: 8px;
    border-inline-start: 3px solid var(--accent);
  }

  /* Markdown Body Styles */
  .article-body {
    font-size: 1.05rem;
    line-height: 1.95;
    color: var(--ink);
  }

  .article-body :global(h2) {
    font-size: 1.45rem;
    line-height: 1.45;
    margin-block: 2.75rem 1rem;
    padding-block-end: 0.4rem;
    border-block-end: 1px solid var(--rule);
  }

  .article-body :global(h3) {
    font-size: 1.2rem;
    line-height: 1.45;
    margin-block: 2rem 0.75rem;
  }

  .article-body :global(p) {
    margin-block: 0 1.5rem;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin-block: 0 1.5rem;
    padding-inline-start: 1.5rem;
  }

  .article-body :global(li) {
    margin-block-end: 0.4rem;
  }

  .article-body :global(blockquote) {
    margin: 1.75rem 0;
    padding: 0.75rem 1.25rem;
    border-inline-start: 4px solid var(--accent);
    background: var(--bg);
    color: var(--ink-2);
    font-style: italic;
  }

  .article-body :global(pre) {
    margin-block: 1.5rem 2rem;
    padding: 1.25rem;
    border-radius: 8px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.6;
    background: #1e2227 !important;
    color: #e6edf3 !important;
  }

  .article-body :global(:not(pre) > code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    padding: 0.15em 0.45em;
    background: var(--accent-soft);
    color: var(--accent-strong);
    border-radius: 4px;
  }

  .article-body :global(strong) {
    color: var(--ink);
    background: linear-gradient(transparent 65%, var(--marker) 65%);
  }

  /* Author Card Footer */
  .article-footer {
    margin-block-start: 3.5rem;
    padding-block-start: 2rem;
    border-block-start: 1px solid var(--rule);
  }

  .author-card {
    display: flex;
    gap: 1.5rem;
    background: var(--bg);
    padding: 1.5rem;
    border-radius: var(--radius);
  }

  .author-avatar {
    inline-size: 3.5rem;
    block-size: 3.5rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--rule);
    flex-shrink: 0;
  }

  .author-info {
    flex: 1;
  }

  .author-name {
    font-size: 1rem;
    display: block;
    margin-block-end: 0.35rem;
  }

  .author-bio {
    font-size: 0.875rem;
    color: var(--ink-2);
    line-height: 1.65;
    margin: 0 0 1rem;
  }

  .author-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .btn-small {
    padding: 0.45rem 1rem;
    font-size: 0.8125rem;
  }

  /* Footer */
  .site-footer {
    padding-block: 3rem;
    font-size: 0.875rem;
    color: var(--muted);
    border-block-start: 1px solid var(--rule);
    margin-block-start: 4rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .footer-nav a {
    color: var(--muted);
    text-decoration: none;
  }

  .footer-nav a:hover {
    color: var(--ink);
  }

  .footer-copy {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  @media (max-width: 640px) {
    .brand-desc {
      display: none;
    }
    .author-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .main-nav {
      gap: 0.85rem;
    }
  }
</style>
