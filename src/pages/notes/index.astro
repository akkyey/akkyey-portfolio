---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allNotes = await getCollection('notes', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// Sort by pubDate descending
allNotes.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Collect all unique tags
const allTags = Array.from(new Set(allNotes.flatMap((n) => n.data.tags)));

const formatDate = (d: Date) => {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}.${m}.${day}`;
};
---

<Layout
  title="技術ノート & 検証メモ (Notes) | akkyey"
  description="QiitaにまとめるほどでもないマニアックなCLIワンライナー、ニッチなトラブルシューティング、現場の泥臭い検証ログを蓄積する技術ノート。"
>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand" aria-label="akkyey ホーム">
        <img
          class="brand-avatar"
          src="/akkyey-avatar-96.webp"
          alt=""
          width="36"
          height="36"
        />
        <span class="brand-name">akkyey</span>
        <span class="brand-desc">止まらない仕組みづくり</span>
      </a>

      <nav class="main-nav" aria-label="主要ナビゲーション">
        <a href="/">トップ</a>
        <a href="/#services">できること</a>
        <a href="/#articles">Qiita記事</a>
        <a href="/notes" class="active">技術ノート</a>
        <a href="/#contact" class="nav-cta">相談する</a>
      </nav>
    </div>
  </header>

  <main id="main-content" class="notes-page">
    <div class="container">
      <header class="notes-header">
        <div class="breadcrumbs">
          <a href="/">ホーム</a>
          <span aria-hidden="true">/</span>
          <span>技術ノート</span>
        </div>
        <h1 class="notes-title">技術ノート &amp; 検証メモ</h1>
        <p class="notes-lead">
          Qiitaに体系化してまとめる前の「ニッチなトラブルシューティング」「泥臭い検証ログ」「現場で重宝しているCLIワンライナー」などをストックしています。
        </p>

        {
          allTags.length > 0 && (
            <div class="tags-cloud">
              <span class="tags-label">タグ:</span>
              {allTags.map((t) => (
                <span class="tag-pill">#{t}</span>
              ))}
            </div>
          )
        }
      </header>

      <section class="notes-list-section">
        <div class="notes-list">
          {
            allNotes.map((note) => (
              <article class="note-card">
                <div class="note-meta">
                  <time datetime={note.data.pubDate.toISOString()}>
                    {formatDate(note.data.pubDate)}
                  </time>
                  <div class="note-tags">
                    {note.data.tags.map((tag) => (
                      <span class="note-tag">#{tag}</span>
                    ))}
                  </div>
                </div>

                <h2 class="note-card-title">
                  <a href={`/notes/${note.id}/`}>{note.data.title}</a>
                </h2>

                <p class="note-desc">{note.data.description}</p>

                <div class="note-more">
                  <a href={`/notes/${note.id}/`} class="note-link">
                    記事を読む <span aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <aside class="notes-cta-box">
        <div class="cta-inner">
          <h3>「止まらない仕組みづくり」のご相談・技術壁打ち受付中</h3>
          <p>
            データ収集パイプライン構築、業務自動化、AIエージェント連携など、現場のリアルな困りごとをお聞かせください。
          </p>
          <div class="cta-actions">
            <a href="/#contact" class="btn btn-primary">お問い合わせ・技術相談</a>
            <a href="/#articles" class="btn btn-text">Qiitaの解説記事を見る &rarr;</a>
          </div>
        </div>
      </aside>
    </div>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <p class="footer-brand">
        <strong>akkyey</strong> — 止まらない仕組みづくり
      </p>
      <nav class="footer-nav" aria-label="フッターナビゲーション">
        <a href="/">トップ</a>
        <a href="/#services">できること</a>
        <a href="/#articles">記事</a>
        <a href="/notes">技術ノート</a>
        <a href="/#contact">お問い合わせ</a>
        <a href="https://qiita.com/akkyey" target="_blank" rel="noopener noreferrer">Qiita &nearr;</a>
      </nav>
      <p class="footer-copy">&copy; {new Date().getFullYear()} akkyey</p>
    </div>
  </footer>
</Layout>

<style>
  /* Header */
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 100;
    background: rgba(247, 245, 240, 0.92);
    backdrop-filter: blur(8px);
    border-block-end: 1px solid var(--rule);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    block-size: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--ink);
  }

  .brand-avatar {
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--rule);
    background: var(--surface);
  }

  .brand-name {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1.0625rem;
  }

  .brand-desc {
    font-size: 0.8125rem;
    color: var(--muted);
    padding-inline-start: 0.5rem;
    border-inline-start: 1px solid var(--rule);
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .main-nav a {
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .main-nav a:hover,
  .main-nav a.active {
    color: var(--accent);
  }

  .main-nav .nav-cta {
    background: var(--accent);
    color: var(--on-accent);
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
  }

  /* Notes Page */
  .notes-page {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
    margin-block-end: 1.5rem;
  }

  .breadcrumbs a {
    color: var(--muted);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--accent);
  }

  .notes-header {
    margin-block-end: clamp(2rem, 4vw, 3.5rem);
    border-block-end: 1px solid var(--rule);
    padding-block-end: 2rem;
  }

  .notes-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
  }

  .notes-lead {
    font-size: 1.0625rem;
    color: var(--ink-2);
    line-height: 1.8;
    max-inline-size: 44em;
    margin: 0 0 1.25rem;
  }

  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: 1rem;
  }

  .tags-label {
    font-size: 0.8125rem;
    color: var(--muted);
    font-weight: 600;
  }

  .tag-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.2rem 0.65rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    color: var(--ink-2);
  }

  /* Notes List */
  .notes-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .note-card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 3vw, 2rem);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .note-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
  }

  .note-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-block-end: 0.75rem;
  }

  .note-meta time {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .note-tags {
    display: flex;
    gap: 0.4rem;
  }

  .note-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  .note-card-title {
    font-size: 1.25rem;
    line-height: 1.5;
    margin: 0 0 0.6rem;
  }

  .note-card-title a {
    color: var(--ink);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .note-card-title a:hover {
    color: var(--accent);
  }

  .note-desc {
    margin: 0 0 1rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
    line-height: 1.7;
  }

  .note-more {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .note-link {
    color: var(--accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .note-link:hover {
    text-decoration: underline;
  }

  /* CTA Box */
  .notes-cta-box {
    margin-block-start: clamp(3rem, 6vw, 4.5rem);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: clamp(2rem, 4vw, 3rem);
    text-align: center;
  }

  .cta-inner h3 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
  }

  .cta-inner p {
    color: var(--ink-2);
    font-size: 0.9375rem;
    margin: 0 0 1.5rem;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  /* Footer */
  .site-footer {
    padding-block: 3rem;
    font-size: 0.875rem;
    color: var(--muted);
    border-block-start: 1px solid var(--rule);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .footer-nav a {
    color: var(--muted);
    text-decoration: none;
  }

  .footer-nav a:hover {
    color: var(--ink);
  }

  .footer-copy {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  @media (max-width: 640px) {
    .brand-desc {
      display: none;
    }
    .main-nav {
      gap: 0.85rem;
    }
  }
</style>
